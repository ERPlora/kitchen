{
  "id": "kitchen",
  "name": "Kitchen",
  "version": "2.3.33",
  "description": "Kitchen display system and production orders, tracked from received to ready.",
  "agent": {
    "description": "Single kitchen module: kitchen display system (KDS), production orders (create, track and transition status from firing to serving), stations with product/category routing, and an audit log of kitchen actions.",
    "keywords": [
      "kitchen",
      "display",
      "order",
      "station",
      "kds",
      "cooking",
      "restaurant",
      "pos",
      "food",
      "ticket",
      "log"
    ]
  },
  "depends_on": [
    "sales",
    "inventory"
  ],
  "permissions": [
    "kitchen.view_order",
    "kitchen.add_order",
    "kitchen.change_order",
    "kitchen.delete_order",
    "kitchen.cancel_order",
    "kitchen.complete_order",
    "kitchen.view_settings",
    "kitchen.change_settings",
    "kitchen.manage_settings",
    "kitchen.view_log",
    "kitchen.add_log"
  ],
  "role_permissions": {
    "admin": [
      "*"
    ],
    "cashier": [
      "kitchen.view_order",
      "kitchen.add_order"
    ],
    "manager": [
      "kitchen.view_order",
      "kitchen.add_order",
      "kitchen.change_order",
      "kitchen.delete_order",
      "kitchen.cancel_order",
      "kitchen.complete_order",
      "kitchen.view_settings",
      "kitchen.change_settings",
      "kitchen.view_log",
      "kitchen.add_log"
    ],
    "employee": [
      "kitchen.view_order",
      "kitchen.add_order",
      "kitchen.change_order",
      "kitchen.complete_order",
      "kitchen.view_settings",
      "kitchen.view_log"
    ]
  },
  "navigation": [
    {
      "id": "display",
      "label": "Display",
      "icon": "tv",
      "component": "erp-kitchen-display",
      "chrome": [
        "fullscreen"
      ]
    },
    {
      "id": "active",
      "label": "Commands",
      "icon": "clipboard-outline",
      "component": "erp-kitchen-orders-active"
    },
    {
      "id": "stations",
      "label": "Stations",
      "icon": "flame-outline",
      "component": "erp-kitchen-orders-stations"
    },
    {
      "id": "history",
      "label": "History",
      "icon": "time-outline",
      "component": "erp-kitchen-history"
    }
  ],
  "settings": {
    "title": "Kitchen",
    "icon": "restaurant-outline",
    "schema": "schemas/settings_update.json",
    "get": "kitchen.settings.get",
    "set": "kitchen.settings.update"
  },
  "provides_slots": [
    {
      "slot": "sales.pos.actions",
      "component": "erp-kitchen-pos-fire",
      "permission": "kitchen.add_order",
      "priority": 100
    },
    {
      "slot": "sales.pos.order_info",
      "component": "erp-kitchen-pos-comandas",
      "permission": "kitchen.view_order",
      "priority": 100
    }
  ],
  "migrations": {
    "postgres": [
      "migrations/postgres/001_init.sql",
      "migrations/postgres/002_order_source.sql",
      "migrations/postgres/003_station_destination.sql",
      "migrations/postgres/004_dispatch_snapshot.sql",
      "migrations/postgres/005_quantity_fixed_point.sql",
      "migrations/postgres/006_settings_thresholds.sql",
      {
        "file": "migrations/postgres/007_retire_order_modifier.sql",
        "kind": "contract",
        "since": "1.0.0"
      },
      "migrations/postgres/008_combo_group.sql"
    ]
  },
  "queries": {
    "kitchen.orders.list": {
      "permission": "kitchen.view_order",
      "sql": "queries/orders_list.sql",
      "list": {
        "search": [
          "order_number",
          "customer_id",
          "round_number"
        ],
        "sort": [
          "id",
          "order_number",
          "label",
          "status",
          "order_type",
          "priority",
          "table_id",
          "sale_id",
          "customer_id",
          "waiter_id",
          "round_number",
          "notes",
          "subtotal",
          "tax",
          "discount",
          "total",
          "fired_at",
          "ready_at",
          "served_at",
          "created_at"
        ],
        "default_sort": "created_at",
        "default_dir": "desc",
        "filters": {
          "order_number": {
            "op": "like"
          },
          "label": {
            "op": "like"
          },
          "status": {
            "op": "eq"
          },
          "order_type": {
            "op": "eq"
          },
          "priority": {
            "op": "eq"
          },
          "table_id": {
            "op": "eq"
          },
          "sale_id": {
            "op": "eq"
          },
          "customer_id": {
            "op": "eq"
          },
          "waiter_id": {
            "op": "eq"
          },
          "round_number": {
            "op": "eq"
          },
          "notes": {
            "op": "like"
          },
          "subtotal": {
            "op": "range"
          },
          "tax": {
            "op": "range"
          },
          "discount": {
            "op": "range"
          },
          "total": {
            "op": "range"
          },
          "fired_at": {
            "op": "range"
          },
          "ready_at": {
            "op": "range"
          },
          "served_at": {
            "op": "range"
          },
          "created_at": {
            "op": "range"
          },
          "source_order_id": {
            "op": "eq"
          }
        },
        "page_size": 50
      },
      "ai": {
        "description": "Lists active kitchen orders, optionally filtered by status"
      }
    },
    "kitchen.orders.get": {
      "permission": "kitchen.view_order",
      "sql": "queries/order_get.sql",
      "schema": "schemas/order_get.json",
      "ai": {
        "description": "Retrieves the full detail of a kitchen order by its identifier"
      }
    },
    "kitchen.orders.items": {
      "permission": "kitchen.view_order",
      "sql": "queries/order_items.sql",
      "schema": "schemas/order_items.json",
      "ai": {
        "description": "Lists the line items of a specific kitchen order"
      }
    },
    "kitchen.orders.display": {
      "permission": "kitchen.view_order",
      "sql": "queries/orders_display.sql",
      "schema": "schemas/orders_display.json",
      "ai": {
        "description": "The KDS feed: every kitchen order on the line (pending, preparing, ready) with its lines, one row per line; the display groups by order and station"
      }
    },
    "kitchen.orders.all_day": {
      "permission": "kitchen.view_order",
      "sql": "queries/orders_all_day.sql",
      "schema": "schemas/orders_all_day.json",
      "ai": {
        "description": "All-Day count: total quantity of each product still to be cooked across every ticket on the line, per station"
      }
    },
    "kitchen.stations.list": {
      "permission": "kitchen.view_order",
      "sql": "queries/stations_list.sql",
      "list": {
        "search": [
          "name",
          "name_es",
          "description",
          "printer_name"
        ],
        "sort": [
          "id",
          "name",
          "name_es",
          "description",
          "color",
          "icon",
          "printer_name",
          "sort_order",
          "is_active"
        ],
        "default_sort": "name",
        "default_dir": "asc",
        "filters": {
          "name": {
            "op": "like"
          },
          "name_es": {
            "op": "like"
          },
          "description": {
            "op": "like"
          },
          "color": {
            "op": "eq"
          },
          "icon": {
            "op": "eq"
          },
          "printer_name": {
            "op": "like"
          },
          "sort_order": {
            "op": "eq"
          },
          "is_active": {
            "op": "eq"
          }
        },
        "page_size": 50
      },
      "ai": {
        "description": "Lists the configured kitchen stations"
      }
    },
    "kitchen.stations.pending_counts": {
      "permission": "kitchen.view_order",
      "sql": "queries/items_pending_by_station.sql",
      "schema": "schemas/items_pending_by_station.json",
      "ai": {
        "description": "Returns the count of pending items grouped by kitchen station"
      }
    },
    "kitchen.settings.get": {
      "permission": "kitchen.view_settings",
      "sql": "queries/settings_get.sql",
      "schema": "schemas/settings_get.json",
      "ai": {
        "description": "Retrieves the current kitchen settings (display and order behaviour)"
      }
    },
    "kitchen.logs.list": {
      "permission": "kitchen.view_log",
      "sql": "queries/logs_list.sql",
      "list": {
        "search": [
          "action",
          "order_number",
          "notes"
        ],
        "sort": [
          "id",
          "order_number",
          "order_item_id",
          "station_id",
          "action",
          "performed_by_id",
          "notes",
          "created_at"
        ],
        "default_sort": "created_at",
        "default_dir": "desc",
        "filters": {
          "order_number": {
            "op": "like"
          },
          "order_item_id": {
            "op": "eq"
          },
          "station_id": {
            "op": "eq"
          },
          "action": {
            "op": "eq"
          },
          "performed_by_id": {
            "op": "eq"
          },
          "notes": {
            "op": "like"
          },
          "created_at": {
            "op": "range"
          }
        },
        "page_size": 50
      },
      "ai": {
        "description": "Lists the log of order events processed by the kitchen"
      }
    }
  },
  "commands": {
    "kitchen.orders.create": {
      "permission": "kitchen.add_order",
      "schema": "schemas/order_create.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "create_order"
      },
      "ai": {
        "description": "Creates a new kitchen order (the handler emits kitchen.order.created)"
      }
    },
    "kitchen.orders.update": {
      "permission": "kitchen.change_order",
      "transaction": true,
      "sql": [
        "commands/order_update.sql"
      ],
      "schema": "schemas/order_update.json",
      "emit": [
        "kitchen.order.updated"
      ],
      "ai": {
        "description": "Updates the data of an existing kitchen order"
      }
    },
    "kitchen.orders.set_status": {
      "permission": "kitchen.change_order",
      "schema": "schemas/order_set_status.json",
      "reads": [
        {
          "query": "kitchen.orders.get",
          "params": {
            "order_id": "payload.order_id"
          },
          "required": true
        }
      ],
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "update_order_status"
      },
      "ai": {
        "description": "Moves a kitchen order along the line (fire, mark_ready, recall); the handler emits the matching kitchen.order.* event. Serving and cancelling are their own commands (kitchen.orders.mark_served / kitchen.orders.cancel)"
      }
    },
    "kitchen.orders.mark_served": {
      "permission": "kitchen.complete_order",
      "schema": "schemas/order_mark_served.json",
      "reads": [
        {
          "query": "kitchen.orders.get",
          "params": {
            "order_id": "payload.order_id"
          },
          "required": true
        }
      ],
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "mark_order_served"
      },
      "ai": {
        "description": "Marks a ready kitchen order as served (handed to the guest); the handler emits kitchen.order.served"
      }
    },
    "kitchen.orders.cancel": {
      "permission": "kitchen.cancel_order",
      "schema": "schemas/order_cancel.json",
      "reads": [
        {
          "query": "kitchen.orders.get",
          "params": {
            "order_id": "payload.order_id"
          },
          "required": true
        }
      ],
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "cancel_order"
      },
      "ai": {
        "description": "Cancels a kitchen order that has not been served yet, with an optional reason; the handler emits kitchen.order.cancelled"
      }
    },
    "kitchen.items.bump": {
      "permission": "kitchen.change_order",
      "schema": "schemas/items_bump.json",
      "reads": [
        {
          "query": "kitchen.orders.get",
          "params": {
            "order_id": "payload.order_id"
          },
          "required": true
        },
        {
          "query": "kitchen.orders.items",
          "params": {
            "order_id": "payload.order_id"
          },
          "required": true
        }
      ],
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "bump_items"
      },
      "ai": {
        "description": "Bumps one or several lines of a kitchen order (line pending/preparing → ready); when no line is left cooking the order goes ready by itself. Emits kitchen.item.bumped per line and kitchen.order.ready / kitchen.order.fired when the order follows"
      }
    },
    "kitchen.items.recall": {
      "permission": "kitchen.change_order",
      "schema": "schemas/items_recall.json",
      "reads": [
        {
          "query": "kitchen.orders.get",
          "params": {
            "order_id": "payload.order_id"
          },
          "required": true
        },
        {
          "query": "kitchen.orders.items",
          "params": {
            "order_id": "payload.order_id"
          },
          "required": true
        }
      ],
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "recall_items"
      },
      "ai": {
        "description": "Recalls one or several ready lines of a kitchen order back to preparing (the undo of the bump); a ready order comes back to preparing. Emits kitchen.item.recalled per line and kitchen.order.recalled when the order follows"
      }
    },
    "kitchen.orders.delete": {
      "permission": "kitchen.delete_order",
      "schema": "schemas/order_delete.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "delete_order"
      },
      "ai": {
        "description": "Deletes a kitchen order (destructive, guarded: only pending/cancelled and not linked to a sale)"
      }
    },
    "kitchen.orders.create_from_sale": {
      "permission": "kitchen.add_order",
      "schema": "schemas/order_create_from_sale.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "create_order_from_sale"
      },
      "ai": {
        "description": "Creates a kitchen order automatically from a completed sale (event-driven, idempotent per sale)"
      }
    },
    "kitchen.orders.create_from_order": {
      "permission": "kitchen.add_order",
      "schema": "schemas/order_create_from_order.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "create_order_from_order"
      },
      "ai": {
        "description": "Creates a kitchen ticket from a FIRED ORDER (event `order.fired`, ADR-0141) — the ticket is born when the waiter takes the order, not when the customer pays. Carries an opaque label (e.g. \"Table 4\") that kitchen prints verbatim, so kitchen depends on neither tables nor customers. Each fire is a new round of the same order."
      }
    },
    "kitchen.orders.close_from_order": {
      "permission": "kitchen.complete_order",
      "schema": "schemas/order_close_from_order.json",
      "reads": [
        {
          "query": "kitchen.orders.list",
          "params": {
            "source_order_id": "payload.order_id"
          },
          "required": true
        }
      ],
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "close_orders_from_order"
      },
      "ai": {
        "description": "Takes the rounds of a CLOSED ORDER off the line (event `order.completed`, ADR-0146): a round already bumped becomes served, one still cooking becomes cancelled, and both leave the KDS. Never hangs off `sale.completed`, which also fires on a partial leg of a split bill where the guests are still seated."
      }
    },
    "kitchen.stations.create": {
      "permission": "kitchen.manage_settings",
      "transaction": true,
      "sql": [
        "commands/station_create.sql"
      ],
      "schema": "schemas/station_create.json",
      "emit": [
        "kitchen.station.created"
      ],
      "ai": {
        "description": "Creates a new kitchen station"
      }
    },
    "kitchen.stations.update": {
      "permission": "kitchen.manage_settings",
      "transaction": true,
      "sql": [
        "commands/station_update.sql"
      ],
      "schema": "schemas/station_update.json",
      "emit": [
        "kitchen.station.updated"
      ],
      "ai": {
        "description": "Updates the data of an existing kitchen station"
      }
    },
    "kitchen.stations.delete": {
      "permission": "kitchen.manage_settings",
      "schema": "schemas/station_delete.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "delete_station"
      },
      "ai": {
        "description": "Deletes a kitchen station (destructive, guarded: no active routings nor in-progress items)"
      }
    },
    "kitchen.stations.set_routing": {
      "permission": "kitchen.manage_settings",
      "schema": "schemas/set_routing.json",
      "handler": {
        "type": "wasm",
        "file": "dist/handler.wasm",
        "function": "set_routing"
      },
      "ai": {
        "description": "Configures the routing of products and categories to kitchen stations"
      }
    },
    "kitchen.settings.update": {
      "permission": "kitchen.change_settings",
      "transaction": true,
      "sql": [
        "commands/settings_update.sql"
      ],
      "schema": "schemas/settings_update.json",
      "emit": [
        "kitchen.settings.updated"
      ],
      "ai": {
        "description": "Updates the kitchen settings (display and order behaviour)"
      }
    },
    "kitchen.logs.create": {
      "permission": "kitchen.add_log",
      "transaction": true,
      "sql": [
        "commands/log_create.sql"
      ],
      "schema": "schemas/log_create.json",
      "ai": {
        "description": "Records a new order status event in the kitchen log"
      },
      "expect_rows": {
        "op": "min",
        "n": 1,
        "error": "kitchen.order_unavailable",
        "message": "That kitchen order is not available: it does not exist in this business or it has been deleted."
      }
    },
    "kitchen._bump_counter": {
      "permission": "kitchen.add_order",
      "sql": [
        "commands/_bump_counter.sql"
      ]
    },
    "kitchen._insert_order": {
      "permission": "kitchen.add_order",
      "sql": [
        "commands/_insert_order.sql"
      ]
    },
    "kitchen._insert_item": {
      "permission": "kitchen.add_order",
      "sql": [
        "commands/_insert_item.sql"
      ]
    },
    "kitchen._set_order_status": {
      "permission": "kitchen.change_order",
      "sql": [
        "commands/_set_order_status.sql"
      ],
      "expect_rows": {
        "op": "min",
        "n": 1,
        "error": "kitchen.invalid_transition",
        "message": "That kitchen order is no longer in the state this action requires. Refresh and try again."
      }
    },
    "kitchen._set_item_status": {
      "permission": "kitchen.change_order",
      "sql": [
        "commands/_set_item_status.sql"
      ],
      "expect_rows": {
        "op": "min",
        "n": 1,
        "error": "kitchen.invalid_transition",
        "message": "That kitchen line is no longer in the state this action requires. Refresh and try again."
      }
    },
    "kitchen._cascade_item_status": {
      "permission": "kitchen.change_order",
      "sql": [
        "commands/_cascade_item_status.sql"
      ]
    },
    "kitchen._product_route_set": {
      "permission": "kitchen.manage_settings",
      "sql": [
        "commands/product_route_set.sql"
      ]
    },
    "kitchen._category_route_set": {
      "permission": "kitchen.manage_settings",
      "sql": [
        "commands/category_route_set.sql"
      ]
    },
    "kitchen._station_soft_delete": {
      "permission": "kitchen.manage_settings",
      "sql": [
        "commands/station_delete.sql"
      ]
    },
    "kitchen._order_soft_delete": {
      "permission": "kitchen.delete_order",
      "sql": [
        "commands/order_delete.sql"
      ]
    }
  },
  "events": {
    "listen": {
      "order.fired": {
        "command": "kitchen.orders.create_from_order"
      },
      "order.completed": {
        "command": "kitchen.orders.close_from_order"
      },
      "kitchen.order.fired": {
        "command": "kitchen.logs.create"
      },
      "kitchen.order.received": {
        "command": "kitchen.logs.create"
      },
      "kitchen.order.ready": {
        "command": "kitchen.logs.create"
      },
      "kitchen.order.served": {
        "command": "kitchen.logs.create"
      },
      "kitchen.order.recalled": {
        "command": "kitchen.logs.create"
      },
      "kitchen.order.cancelled": {
        "command": "kitchen.logs.create"
      },
      "kitchen.item.bumped": {
        "command": "kitchen.logs.create"
      },
      "kitchen.item.recalled": {
        "command": "kitchen.logs.create"
      }
    },
    "emits": [
      "kitchen.item.bumped",
      "kitchen.item.recalled",
      "kitchen.order.cancelled",
      "kitchen.order.created",
      "kitchen.order.deleted",
      "kitchen.order.fired",
      "kitchen.order.ready",
      "kitchen.order.recalled",
      "kitchen.order.received",
      "kitchen.order.served",
      "kitchen.order.updated",
      "kitchen.routing.changed",
      "kitchen.settings.updated",
      "kitchen.station.created",
      "kitchen.station.deleted",
      "kitchen.station.updated"
    ]
  },
  "ui": {
    "entry": "dist/kitchen.esm.js"
  }
}
