{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "kitchen.settings.update",
  "description": "Configuración de cocina (singleton por hub): display (KDS) + comportamiento de comandas (fusión ADR-0014). La UI envía el snapshot completo (upsert).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "auto_accept_orders": { "type": "boolean", "default": false, "title": "Aceptar comandas automáticamente" },
    "show_timer": { "type": "boolean", "default": true, "title": "Mostrar cronómetro" },
    "warning_time_minutes": { "type": "integer", "minimum": 1, "maximum": 120, "default": 15, "title": "Tiempo de aviso (minutos)" },
    "critical_time_minutes": { "type": "integer", "minimum": 1, "maximum": 120, "default": 30, "title": "Tiempo crítico (minutos)" },
    "items_per_page": { "type": "integer", "minimum": 4, "maximum": 50, "default": 12, "title": "Comandas por pantalla" },
    "auto_refresh_seconds": { "type": "integer", "minimum": 3, "maximum": 120, "default": 3, "title": "Refresco automático (segundos)" },
    "sound_enabled": { "type": "boolean", "default": true, "title": "Activar sonidos" },
    "sound_on_new_order": { "type": "boolean", "default": true, "title": "Sonido al recibir comanda" },
    "sound_on_rush": { "type": "boolean", "default": true, "title": "Sonido en comanda urgente" },
    "auto_bump_enabled": { "type": "boolean", "default": false, "title": "Auto-completar comandas" },
    "auto_bump_delay_seconds": { "type": "integer", "minimum": 1, "maximum": 300, "default": 5, "title": "Retardo de auto-completado (segundos)" },
    "color_coding_enabled": { "type": "boolean", "default": true, "title": "Código de colores por tiempo" },
    "auto_print_tickets": { "type": "boolean", "default": true, "title": "Imprimir tickets automáticamente" },
    "use_rounds": { "type": "boolean", "default": true, "title": "Usar rondas" },
    "auto_fire_on_round": { "type": "boolean", "default": false, "title": "Lanzar ronda automáticamente" },
    "default_order_type": {
      "type": "string",
      "enum": ["dine_in", "takeaway", "delivery"],
      "default": "dine_in",
      "title": "Tipo de pedido por defecto"
    }
  },
  "required": [
    "auto_accept_orders",
    "show_timer",
    "warning_time_minutes",
    "critical_time_minutes",
    "items_per_page",
    "auto_refresh_seconds",
    "sound_enabled",
    "sound_on_new_order",
    "sound_on_rush",
    "auto_bump_enabled",
    "auto_bump_delay_seconds",
    "color_coding_enabled",
    "auto_print_tickets",
    "use_rounds",
    "auto_fire_on_round",
    "default_order_type"
  ]
}
