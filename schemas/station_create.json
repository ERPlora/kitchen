{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "kitchen.stations.create",
  "type": "object",
  "additionalProperties": false,
  "required": ["name"],
  "properties": {
    "name": { "type": "string", "minLength": 1, "maxLength": 100 },
    "name_es": { "type": "string", "default": "", "maxLength": 100 },
    "description": { "type": "string", "default": "" },
    "color": { "type": "string", "default": "#F97316", "maxLength": 7 },
    "icon": { "type": "string", "default": "flame-outline", "maxLength": 50 },
    "printer_name": { "type": "string", "default": "", "maxLength": 100 },
    "destination": {
      "description": "Por dónde sale la comanda de esta estación. `both` por defecto: si fuese `display`, un hub que actualiza dejaría de imprimir sin tocar nada y la cocina se entera con la comida fría.",
      "type": "string",
      "enum": ["display", "printer", "both"],
      "default": "both"
    },
    "printer_role": {
      "description": "ROL de impresora del Bridge (`kitchen`, `bar`, …), no un dispositivo: qué impresora física es eso vive en el Bridge y puede cambiar sin tocar el hub.",
      "type": "string",
      "default": "kitchen",
      "maxLength": 50
    },
    "sort_order": { "type": "integer", "minimum": 0, "default": 0 }
  }
}
